# Database connection URL for read-only analytical queries
DATABASE_URL=postgresql://lms_readonly:lms_readonly_dev_pass@localhost:5433/lms

# Or individual database connection parameters:
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lms
DB_USER=lms_readonly
DB_PASSWORD=lms_readonly_dev_pass

# Internal JWT shared secret (must match backend app.jwt.internal-secret, >= 32 UTF-8 bytes)
INTERNAL_JWT_SECRET=lms_internal_jwt_super_secret_key_32_bytes_min!

# Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Environment: development, test, production
ENVIRONMENT=development
