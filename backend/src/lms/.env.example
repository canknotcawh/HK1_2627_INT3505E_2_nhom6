# For access from another device, replace 192.168.2.15 with this computer's
# LAN address. Keep the issuer host the same as KC_HOSTNAME.
KC_HOSTNAME=http://192.168.2.15:8081
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
KEYCLOAK_ISSUER_URI=http://192.168.2.15:8081/realms/lms
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000,http://192.168.2.15:5173,http://192.168.2.15:5175
BOOTSTRAP_ADMIN_EMAIL=
