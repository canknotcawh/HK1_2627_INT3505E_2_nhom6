# Copy to .env and fill in real values. run-dev.sh sources this automatically.

# For access from another device, replace localhost with this computer's LAN address.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000

# Admin bootstrap: any Google account whose email is listed here becomes ADMIN on first login.
APP_BOOTSTRAP_ADMIN_EMAILS=admin@lms.local

# Google OAuth2 client ID (from Google Cloud Console) used to verify the ID token the frontend sends.
GOOGLE_CLIENT_ID=

# HMAC secret used to sign/verify the app's own JWTs. 32+ bytes, keep it secret outside dev.
JWT_SECRET=dev-only-change-me-32-bytes-minimum-secret
